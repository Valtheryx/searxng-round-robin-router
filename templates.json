{
  "version": "3",
  "templates": [
    {
      "type": 2,
      "title": "SearXNG Round-Robin Router",
      "description": "Tiny Node.js dispatcher in front of SearXNG: rotates search queries through engine groups via SearXNG bangs to reduce upstream rate limits and CAPTCHAs. Runs on node:22-alpine.",
      "logo": "",
      "image": "node:22-alpine",
      "repository": {
        "url": "https://github.com/Valtheryx/searxng-round-robin-router",
        "stackfile": "docker-compose.yml"
      },
      "platform": "linux",
      "categories": ["docker", "search"],
      "volumes": [
        {
          "container": "/app",
          "bind": "/opt/docker/searx-router"
        }
      ],
      "ports": ["8096:8080/tcp"],
      "env": [
        {
          "name": "SEARXNG_URL",
          "label": "SearXNG base URL",
          "default": "http://172.30.1.3:8093"
        },
        {
          "name": "ROUTER_HOST_PORT",
          "label": "Host port for clients",
          "default": "8096"
        },
        {
          "name": "GROUPS",
          "label": "Optional engine groups (JSON array-of-arrays)",
          "default": ""
        }
      ]
    }
  ]
}